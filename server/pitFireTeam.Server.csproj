<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>pitFireTeam.Server</AssemblyName>
    <RootNamespace>pitTeam.Server</RootNamespace>
    <Version>0.9.2</Version>
    <OutputType>Library</OutputType>
    <SptReferenceRoot Condition="'$(SptReferenceRoot)' == ''">$(MSBuildProjectDirectory)/refs/4.0.13</SptReferenceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="SPTarkov.Common">
      <HintPath>$(SptReferenceRoot)/SPTarkov.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>$(SptReferenceRoot)/SPTarkov.DI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>$(SptReferenceRoot)/SPTarkov.Server.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SemanticVersioning">
      <HintPath>$(SptReferenceRoot)/SemanticVersioning.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Resources\" />
    <None Remove="refs\**\*" />
  </ItemGroup>
  <Target Name="ValidateSptReferences" BeforeTargets="ResolveReferences">
    <ItemGroup>
      <RequiredSptReference Include="$(SptReferenceRoot)/SPTarkov.Common.dll" />
      <RequiredSptReference Include="$(SptReferenceRoot)/SPTarkov.DI.dll" />
      <RequiredSptReference Include="$(SptReferenceRoot)/SPTarkov.Server.Core.dll" />
      <RequiredSptReference Include="$(SptReferenceRoot)/SemanticVersioning.dll" />
    </ItemGroup>
    <Error
      Condition="!Exists('%(RequiredSptReference.Identity)')"
      Text="Required SPT 4.0.13 server reference was not found: %(RequiredSptReference.Identity)"
    />
  </Target>
</Project>
