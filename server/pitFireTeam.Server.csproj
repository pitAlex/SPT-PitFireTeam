<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>pitFireTeam.Server</AssemblyName>
    <RootNamespace>pitTeam.Server</RootNamespace>
    <Version>0.10.0</Version>
    <OutputType>Library</OutputType>
    <SptRuntimeRoot Condition="'$(SptRuntimeRoot)' == ''">/home/mariag/Games/escape-from-tarkov/drive_c/SPT_4.1.x/SPT_Runtime</SptRuntimeRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="SPTarkov.Common">
      <HintPath>$(SptRuntimeRoot)/SPTarkov.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>$(SptRuntimeRoot)/SPTarkov.DI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>$(SptRuntimeRoot)/SPTarkov.Server.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SemanticVersioning">
      <HintPath>$(SptRuntimeRoot)/SemanticVersioning.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Resources\" />
  </ItemGroup>
  <Target Name="ValidateSptReferences" BeforeTargets="ResolveReferences">
    <Error
      Condition="!Exists('$(SptRuntimeRoot)/SPTarkov.Server.Core.dll')"
      Text="SPT 4.1 runtime references were not found at '$(SptRuntimeRoot)'. Set SptRuntimeRoot to the SPT_Runtime directory."
    />
  </Target>
</Project>
